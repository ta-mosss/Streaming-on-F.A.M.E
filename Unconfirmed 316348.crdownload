/* ---------- DOM ---------- */
const $  = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => Array.from(r.querySelectorAll(s));

/* ---------- STATE ---------- */
const state = {
  category: 'all',
  theme: localStorage.getItem('fame-theme') || 'dark'
};

/* =========================================================
   THEME
   ========================================================= */
function applyTheme(t){
  document.documentElement.classList.toggle('light', t === 'light');
  const meta = document.querySelector('meta[name="theme-color"]');
  if(meta) meta.setAttribute('content', t === 'light' ? '#FFFFFF' : '#0D0D0D');
  localStorage.setItem('fame-theme', t);
  state.theme = t;
}
applyTheme(state.theme);

$('#themeBtn').addEventListener('click', () => {
  applyTheme(state.theme === 'dark' ? 'light' : 'dark');
  toast(state.theme === 'light' ? 'Light mode on' : 'Dark mode on');
});

/* =========================================================
   TOAST
   ========================================================= */
let toastTimer;
function toast(msg){
  const el = $('#toast');
  el.textContent = msg;
  el.classList.add('on');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('on'), 2600);
}

/* =========================================================
   RENDER POSTER GRID
   ========================================================= */
function posterCard(item){
  return `
    <article class="poster-card" data-title="${item.title}">
      <div class="art" style="background:linear-gradient(135deg,${item.art[0]},${item.art[1]})">
        ${item.tag ? `<span class="tag">${item.tag}</span>` : ''}
        <span class="ttl">${item.title}</span>
      </div>
      <div class="meta">
        <b>${item.title}</b>
        <span>${item.meta}</span>
      </div>
    </article>`;
}

function renderPosters(){
  const grid = $('#posterGrid');
  const cat = state.category;
  const items = cat === 'all'
    ? CATALOGUE
    : CATALOGUE.filter(i => i.cat.split(' ').includes(cat));

  grid.innerHTML = items.map(posterCard).join('');

  $$('.poster-card', grid).forEach(card => {
    card.addEventListener('click', () => {
      toast(`"${card.dataset.title}" — streaming on F.A.M.E from 1 June 2027`);
    });
  });
}

/* Category chips */
$('#categoryChips').addEventListener('click', e => {
  const btn = e.target.closest('.chip');
  if(!btn) return;
  $$('#categoryChips .chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  state.category = btn.dataset.cat;
  renderPosters();
});

renderPosters();

/* =========================================================
   SEARCH DRAWER
   ========================================================= */
const drawer = $('#searchDrawer');
const input  = $('#searchInput');
const results = $('#searchResults');

function openSearch(){
  drawer.classList.add('open');
  drawer.setAttribute('aria-hidden', 'false');
  setTimeout(() => input.focus(), 60);
}
function closeSearch(){
  drawer.classList.remove('open');
  drawer.setAttribute('aria-hidden', 'true');
}

$('#searchBtn').addEventListener('click', openSearch);
$('#closeSearch').addEventListener('click', closeSearch);
drawer.addEventListener('click', e => { if(e.target === drawer) closeSearch(); });

function runSearch(q){
  q = q.trim().toLowerCase();
  if(!q){
    results.innerHTML = `<p class="search-empty">Start typing to discover what's coming to F.A.M.E.</p>`;
    return;
  }
  const hits = CATALOGUE.filter(i =>
    i.title.toLowerCase().includes(q) ||
    i.meta.toLowerCase().includes(q) ||
    i.cat.includes(q)
  );
  if(!hits.length){
    results.innerHTML = `<p class="search-empty">No results for "${q}". Try a different title or category.</p>`;
    return;
  }
  results.innerHTML = hits.slice(0, 12).map(i => `
    <div class="search-result-item" data-title="${i.title}">
      <b>${i.title}</b>
      <span>${i.meta}</span>
    </div>`).join('');

  $$('.search-result-item', results).forEach(el => {
    el.addEventListener('click', () => {
      closeSearch();
      toast(`"${el.dataset.title}" — coming 1 June 2027`);
    });
  });
}
input.addEventListener('input', e => runSearch(e.target.value));

$$('.search-tags button').forEach(b => {
  b.addEventListener('click', () => {
    input.value = b.textContent;
    runSearch(b.textContent);
    input.focus();
  });
});

