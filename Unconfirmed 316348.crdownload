const legalModal = $('#legalModal');
$('#closeLegal').addEventListener('click', () => legalModal.classList.remove('open'));
legalModal.addEventListener('click', e => { if(e.target === legalModal) legalModal.classList.remove('open'); });

$$('[data-legal]').forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    const doc = LEGAL[a.dataset.legal];
    if(!doc) return;
    $('#legalTitle').textContent = doc.title;
    $('#legalBody').innerHTML = doc.body;
    legalModal.classList.add('open');
  });
});

/* =========================================================
   WAITLIST
   ========================================================= */
const form = $('#waitlistForm');
const emailInput = $('#waitlistEmail');
const note = $('#waitlistNote');

form.addEventListener('submit', e => {
  e.preventDefault();
  const email = emailInput.value.trim();
  const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  if(!valid){
    note.textContent = 'Please enter a valid email address.';
    note.classList.remove('ok');
    emailInput.focus();
    return;
  }
  // Store locally (replace with real API call when backend is ready)
  const list = JSON.parse(localStorage.getItem('fame-waitlist') || '[]');
  if(!list.includes(email)) list.push(email);
  localStorage.setItem('fame-waitlist', JSON.stringify(list));

  form.reset();
  note.textContent = '✓ You\'re on the list! We\'ll be in touch before launch.';
  note.classList.add('ok');
  toast('Welcome to the F.A.M.E waitlist');
});

/* =========================================================
   HEADER — solid on scroll + active nav highlighting
   ========================================================= */
const header = $('#topbar') || $('.site-header');
window.addEventListener('scroll', () => {
  header.classList.toggle('solid', window.scrollY > 40);
}, {passive:true});

/* Active nav link on scroll */
const navLinks = $$('.desktop-nav a');
const sections = navLinks.map(a => document.querySelector(a.getAttribute('href'))).filter(Boolean);
if('IntersectionObserver' in window){
  const navObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + entry.target.id));
      }
    });
  }, {rootMargin:'-45% 0px -50% 0px'});
  sections.forEach(s => navObs.observe(s));
}

/* Mobile tab active state */
const mobileTabs = $$('.mobile-tabs a');
mobileTabs.forEach(tab => {
  tab.addEventListener('click', () => {
    mobileTabs.forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
  });
});

/* =========================================================
   REVEAL ON SCROLL
   ========================================================= */
const revealTargets = [
  '.section-heading','.about-grid','.preview-grid','.feature',
  '.poster-card','.device','.plan','.step','.tl-item',
  '.waitlist-inner','.faq details','.about > *','.fact-card'
];
const revealEls = $$(revealTargets.join(','));
revealEls.forEach(el => el.classList.add('reveal'));

if('IntersectionObserver' in window){
  const obs = new IntersectionObserver((entries, o) => {
    entries.forEach((entry, i) => {
      if(entry.isIntersecting){
        setTimeout(() => entry.target.classList.add('in'), i * 45);
        o.unobserve(entry.target);
      }
    });
  }, {threshold:0.12, rootMargin:'0px 0px -40px 0px'});
  revealEls.forEach(el => obs.observe(el));
} else {
  revealEls.forEach(el => el.classList.add('in'));
}

/* =========================================================
   KEYBOARD
   ========================================================= */
window.addEventListener('keydown', e => {
  if(e.key === 'Escape'){
    closeSearch();
    legalModal.classList.remove('open');
  }
  // "/" opens search
  if(e.key === '/' && document.activeElement.tagName !== 'INPUT'){
    e.preventDefault();
    openSearch();
  }
});

/* =========================================================
   SMOOTH SCROLL FALLBACK (older browsers)
   ========================================================= */
$$('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const id = a.getAttribute('href');
    if(id === '#' || id.length < 2) return;
    const target = document.querySelector(id);
    if(!target) return;
    e.preventDefault();
    const top = target.getBoundingClientRect().top + window.pageYOffset - 70;
    window.scrollTo({top, behavior:'smooth'});
  });
});

/* =========================================================
   FOOTER YEAR
   ========================================================= */
const copy = document.querySelector('.copyright');
if(copy){
  copy.innerHTML = copy.innerHTML.replace('2026', new Date().getFullYear());
}